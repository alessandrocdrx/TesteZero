[
 {
  "start": 0,
  "end": 3.2,
  "lines": [
   "Isso aqui",
   "é pra você."
  ],
  "big": true,
  "italic": true
 },
 {
  "start": 3.7,
  "end": 9.1,
  "lines": [
   "Tem gente que passa",
   "a vida inteira",
   "sem se encontrar."
  ]
 },
 {
  "start": 9.6,
  "end": 14.16,
  "lines": [
   "Você se encontrou…",
   "e teve coragem",
   "de ficar."
  ]
 },
 {
  "start": 14.66,
  "end": 18.38,
  "lines": [
   "Atravessou o espelho",
   "quando ele mentia,"
  ]
 },
 {
  "start": 18.88,
  "end": 23.86,
  "lines": [
   "e ensinou o próprio reflexo",
   "a dizer a verdade."
  ]
 },
 {
  "start": 24.36,
  "end": 27.66,
  "lines": [
   "Cada passo seu",
   "foi coragem."
  ]
 },
 {
  "start": 28.16,
  "end": 31.46,
  "lines": [
   "Cada “eu sou”…",
   "uma revolução."
  ]
 },
 {
  "start": 31.96,
  "end": 37.36,
  "lines": [
   "O azul é o céu",
   "que ninguém pôde",
   "te negar."
  ]
 },
 {
  "start": 37.86,
  "end": 43.26,
  "lines": [
   "O rosa, a flor",
   "que brotou no meio",
   "do asfalto."
  ]
 },
 {
  "start": 43.76,
  "end": 51.26,
  "lines": [
   "E o branco…",
   "é tudo o que ainda vem.",
   "O futuro, esperando",
   "a sua letra."
  ]
 },
 {
  "start": 51.76,
  "end": 55.9,
  "lines": [
   "Você não precisa",
   "pedir licença",
   "pra existir."
  ]
 },
 {
  "start": 56.4,
  "end": 60.12,
  "lines": [
   "Não precisa provar",
   "nada a ninguém."
  ]
 },
 {
  "start": 60.62,
  "end": 66.44,
  "lines": [
   "Mas se um dia",
   "você esquecer o tamanho",
   "da sua luz…"
  ]
 },
 {
  "start": 66.94,
  "end": 69.94,
  "lines": [
   "volta aqui.",
   "E escuta:"
  ],
  "italic": true
 },
 {
  "start": 70.44,
  "end": 73.64,
  "lines": [
   "Você é linda."
  ],
  "big": true
 },
 {
  "start": 74.14,
  "end": 77.34,
  "lines": [
   "Você é forte."
  ],
  "big": true
 },
 {
  "start": 77.84,
  "end": 81.04,
  "lines": [
   "Você é mulher."
  ],
  "big": true
 },
 {
  "start": 81.54,
  "end": 89.46,
  "lines": [
   "E o mundo ficou",
   "mais bonito",
   "no dia em que você",
   "teve coragem",
   "de ser você."
  ]
 },
 {
